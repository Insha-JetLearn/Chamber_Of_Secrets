rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEntry(data) {
      return data.keys().hasAll(['userId', 'entryText', 'aiResponse', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'entryText', 'aiResponse', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.entryText is string && data.entryText.size() <= 10000 &&
             data.aiResponse is string && data.aiResponse.size() <= 10000;
    }

    match /entries/{entryId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       isValidEntry(request.resource.data) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      allow update: if isOwner(resource.data.userId) &&
                       isValidId(entryId) &&
                       isValidEntry(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entryText', 'aiResponse', 'updatedAt']);
      allow delete: if isOwner(resource.data.userId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) &&
                               isValidId(userId) &&
                               request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);
    }
  }
}
